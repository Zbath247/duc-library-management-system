{
  "name": "duc-library-management-system",
  "version": "1.0.0",
  "description": "Library Management System for Digital University of Cambodia (DUC)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "node src/db/migrate.js && node src/db/seed.js"
  },
  "keywords": [
    "library",
    "duc",
    "cambodia",
    "management-system"
  ],
  "author": "Digital University of Cambodia",
  "engines": {
    "node": ">=22.x"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.16.0",
    "xlsx": "^0.18.5"
  }
}
